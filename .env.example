# ===== AppRH - exemple de configuration =====
# 1. Copiez ce fichier en `.env`  :  Copy-Item .env.example .env
# 2. Renseignez vos valeurs (notamment JWT_SECRET et DB_PASSWORD, obligatoires).
# Le fichier `.env` est ignoré par git (voir .gitignore) : n'y commitez JAMAIS de secret.

# ----- Profil Spring -----
# « dev » (développement local, par défaut) ou « prod » (production).
SPRING_PROFILES_ACTIVE=dev

# ----- Sécurité -----
# Secret de signature des jetons JWT. OBLIGATOIRE pour Docker/production.
# Chaîne aléatoire d'au moins 32 caractères. Générez-en une, par exemple :
#   openssl rand -base64 48
# Laissez vide ici : la valeur réelle se renseigne uniquement dans .env (jamais commité).
JWT_SECRET=

# ----- Base de données PostgreSQL (OBLIGATOIRE pour Docker) -----
# Nom de la base et utilisateur applicatif.
DB_NAME=apprh
DB_USERNAME=apprh
# Mot de passe dédié au déploiement. N'utilisez PAS de mot de passe par défaut.
# Générez-en un robuste, par exemple : openssl rand -base64 24
DB_PASSWORD=

# ----- Comptes de démonstration (optionnel) -----
# Activés automatiquement avec le profil « dev », TOUJOURS désactivés avec « prod ».
# En production, laissez SEED_ENABLED=false (aucun compte de démonstration ne doit exister).
SEED_ENABLED=true
# Mot de passe des comptes de démonstration (développement uniquement).
SEED_PASSWORD=Apprh@2026!

# ----- Emails (SMTP Gmail, optionnel) -----
# Mettre MAIL_ENABLED=false pour désactiver l'envoi réel d'emails (dev).
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Adresse Gmail complète (ex : moncompte@gmail.com)
MAIL_USERNAME=
# "Mot de passe d'application" Gmail (16 caractères) — pas le mot de passe du compte.
# Obtenir un mot de passe d'application : https://myaccount.google.com/apppasswords
MAIL_PASSWORD=
# Expéditeur affiché (doit correspondre à MAIL_USERNAME pour Gmail)
MAIL_FROM=

# ----- Assistant RH IA (optionnel, des valeurs par défaut s'appliquent) -----
# Modèle Ollama utilisé par l'ia-service.
CHATBOT_OLLAMA_MODEL=llama3.2:3b
# Délai maximal (ms) accordé au LLM côté backend.
CHATBOT_TIMEOUT_MS=90000
