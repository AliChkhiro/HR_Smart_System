# ===== AppRH — exemple de configuration =====
# 1. Copiez ce fichier en `.env`  :  Copy-Item .env.example .env
# 2. Renseignez vos valeurs.
# Le fichier `.env` est ignoré par git (voir .gitignore) : n'y commitez JAMAIS de secret.

# ----- Sécurité -----
# Secret de signature des jetons JWT. Chaîne aléatoire longue (32 caractères minimum).
JWT_SECRET=change-me-with-a-long-random-secret

# ----- Emails (SMTP Gmail, optionnel) -----
# Mettre MAIL_ENABLED=false pour désactiver l'envoi réel d'emails (dev).
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Adresse Gmail complète (ex : moncompte@gmail.com)
MAIL_USERNAME=
# "Mot de passe d'application" Gmail (16 caractères) — pas le mot de passe du compte.
# Obtenir un mot de passe d'application : https://myaccount.google.com/apppasswords
MAIL_PASSWORD=
# Expéditeur affiché (doit correspondre à MAIL_USERNAME pour Gmail)
MAIL_FROM=

# ----- Assistant RH IA (optionnel, des valeurs par défaut s'appliquent) -----
# Modèle Ollama utilisé par l'ia-service.
CHATBOT_OLLAMA_MODEL=llama3.2:3b
# Délai maximal (ms) accordé au LLM côté backend.
CHATBOT_TIMEOUT_MS=90000
